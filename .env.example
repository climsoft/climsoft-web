#-------------------------------------
# Climsoft PWA and API web settings.
HOST_HTTP_PORT=8080
FIRST_INSTALL=yes
# Encyption secrets has to be atleast 32 characters long
ENCRYPTION_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars

#-------------------------------------
# Climsoft web database credentials.
DB_NAME=climsoft
DB_PASSWORD=my_password

#-------------------------------------
# Adapter runner microservices (Python/R/JavaScript/DuckDB script runners)
PYTHON_RUNNER_ENABLED=true
R_RUNNER_ENABLED=true
JAVASCRIPT_RUNNER_ENABLED=true
DUCKDB_RUNNER_ENABLED=true

#-------------------------------------
# Climate Products (Apache Superset) settings
SUPERSET_ENABLED=true
# Must be a random string of at least 42 characters
SUPERSET_SECRET_KEY=change_me_to_a_long_random_string_of_at_least_42_chars
# Human sysadmin account — used to log into the Superset UI
SUPERSET_ADMIN_USERNAME=superset_admin
SUPERSET_ADMIN_PASSWORD=change_me
# Service account used by the Climsoft API to generate guest tokens (keep separate from the sysadmin account)
SUPERSET_SERVICE_USERNAME=climsoft_service
SUPERSET_SERVICE_PASSWORD=change_me_service
# Read-only PostgreSQL account used by Superset to query the climsoft database for dashboards
CLIMSOFT_READER_PASSWORD=change_me_reader
# Superset is reverse-proxied on its OWN hostname, not a path under the main
# app's origin — its frontend code doesn't work reliably behind a path
# prefix as explained in the Apache Superset GitHub issues. 
# So it must be a real hostname resolvable to wherever
# nginx runs, that is, a DNS subdomain in production (e.g. superset.kmd.climsoft.systems),
# pointed at the same host as the main app.
SUPERSET_HOSTNAME=superset.localhost

#-------------------------------------
# Climsoft V4 database credentials
V4_SAVE=yes
V4_IMPORT=yes
V4_DB_HOST=host.docker.internal #192.168.100.11
V4_DB_PORT=3308
V4_DB_NAME=mariadb_climsoft_db_v4
V4_DB_USERNAME=my_user
V4_DB_PASSWORD=my_password
V4_DB_UTCOFFSET=0
